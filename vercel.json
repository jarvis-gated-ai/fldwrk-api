{
  "version": 2,
  "installCommand": "npm install --ignore-scripts",
  "buildCommand": "echo 'skip — @vercel/node handles transpilation'",
  "outputDirectory": ".",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
